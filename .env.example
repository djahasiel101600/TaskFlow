# Docker Compose environment (optional).
# Copy to .env and adjust. Defaults in docker-compose.yml work for local run.
#
# Postgres (used when running full stack with compose)
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
#
# Django (backend)
SECRET_KEY=change-me-in-production
DEBUG=False
#
# If you use a different frontend port or host, set so CORS/CSRF allow it:
# FRONTEND_ORIGIN=http://localhost:8080
